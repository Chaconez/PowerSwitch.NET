<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="PowerSwitch.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <!--
    DPI 感知不在这里声明。

    .NET 6+ 的 WinForms 要求通过 Application.SetHighDpiMode(HighDpiMode.SystemAware)
    配置（见 Program.Main 第一行）：清单里的 dpiAware/dpiAwareness 会和运行时的
    DPI 模式相互覆盖，导致缩放忽大忽小，编译器也会报 WFAC010。
    SystemAware 的语义等同于原来清单里的 dpiAware=true + dpiAwareness=system：
    由程序自己按 Graphics.FromHwnd(IntPtr.Zero).DpiX 缩放，字形由系统按真实 DPI 绘制。
  -->

  <!-- 视觉样式（自定义 manifest 会覆盖 csc 的默认 manifest，所以要显式带上） -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
