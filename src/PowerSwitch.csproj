<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PowerSwitch 主程序（托盘 + 设置窗口）。

    目标框架 net8.0-windows / 框架依赖发布：
      · 目标机需装 .NET 8 Desktop Runtime（WindowsDesktop.App 8.x）
      · 发布产物是单个 exe（PublishSingleFile），体积约 400 KB

    版本与描述写在下面，由 SDK 生成 AssemblyInfo。
    不要再设 GenerateAssemblyInfo=false —— 那会连带丢掉 SDK 注入的
    [assembly: SupportedOSPlatform("windows7.0")]，导致每个 WinForms API
    都被 CA1416 判为「仅 Windows 支持」而刷出数百条告警。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PowerSwitch</AssemblyName>
    <RootNamespace>PowerSwitch</RootNamespace>
    <ApplicationIcon>icons\icon-balanced.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- 程序集信息 -->
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <Product>PowerSwitch</Product>
    <Title>PowerSwitch</Title>
    <Description>NAS 电源计划自动切换：按 CPU 负载与夜间时段在节能/平衡/高性能间切换，远程桌面连接时自动锁定方案</Description>
    <ComVisible>false</ComVisible>

    <!-- 发布：框架依赖 + 单文件 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\build\out\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标以嵌入资源形式打包，逻辑名与 AppIcon.cs 里的字符串必须一致 -->
    <EmbeddedResource Include="icons\*.ico" LogicalName="PowerSwitch.icons.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
